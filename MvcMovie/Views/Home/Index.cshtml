@{
    ViewData["Title"] = "Home Page";
}

    @if (User.Identity.IsAuthenticated)
    {
        <p>Hello, <strong>@ViewBag.UserName</strong>!</p>
        <p>Your email is: <strong>@ViewBag.UserEmail</strong>.</p>
        <a asp-controller="Home" asp-action="Logout" class="btn btn-danger">Logout</a>
    }
    else
    {
        <p>You are not logged in.</p>
        <a asp-controller="Home" asp-action="Login" class="btn btn-primary">Login with Google</a>
    }